---
{name === 'whatsapp' ? <img class="whatsapp-mark" src="/images/whatsapp-mark.svg" alt="" width={size} height={size} aria-hidden="true" {...rest}/> : <svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.65" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" {...rest} set:html={paths[name] || paths.tooth} />}
