---
import Icon from '../components/Icon.astro';
import { clinic } from '../data.js';
import '../styles/global.css';
import '../styles/blog.css';
const {title,description,image='/images/blog/prevention.webp',schema,draft=false}=Astro.props;
const canonical=new URL(Astro.url.pathname,Astro.site);
---
<!doctype html>
<html lang="en"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>{title} | Shakuntala Dental Clinic</title><meta name="description" content={description}/><link rel="canonical" href={canonical}/>{draft&&<meta name="robots" content="noindex,follow"/>}<meta property="og:type" content={schema?.['@type']==='Article'?'article':'website'}/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:url" content={canonical}/><meta property="og:image" content={new URL(image,Astro.site)}/><meta name="twitter:card" content="summary_large_image"/><meta name="theme-color" content="#103875"/><link rel="icon" href="/favicon.svg"/><link rel="preconnect" href="https://fonts.googleapis.com"/><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/><link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet"/>{schema&&<script type="application/ld+json" set:html={JSON.stringify(schema)}/>}</head>
<body class="blog-page"><a class="skip-link" href="#main">Skip to content</a><header class="header"><div class="container blog-nav"><a class="brand" href="/"><img src="/images/glass-tooth.webp" alt="" width="35" height="45"/><span>Shakuntala<small>Dental Clinic</small></span></a><nav aria-label="Main navigation"><a href="/blog/">All guides</a><a href="/#doctor">Your dentist</a><a href="/#contact">Find us</a></nav><a class="blog-call" href="tel:+916201049711" aria-label="Call the clinic on +91 62010 49711"><Icon name="phone" size={19}/><span>+91 62010 49711</span></a><a class="button" href="/#appointment">Request appointment <Icon name="arrowUp" size={17}/></a></div></header>
<main id="main"><slot/></main>
<footer class="blog-footer"><div class="container"><div><a class="brand" href="/" aria-label="Shakuntala Dental Clinic home"><img src="/images/glass-tooth.webp" width="38" height="42" alt=""/><span>Shakuntala<small>Dental Clinic</small></span></a><p>Dr. Rohan Bharti, BDS · Dental Surgeon</p><address>{clinic.address}</address><p>Monday–Sunday · 10:30 AM–7:00 PM</p></div><div><a href="tel:+916201049711">Call +91 62010 49711</a><a href={clinic.whatsapp} target="_blank" rel="noopener noreferrer">WhatsApp the clinic ↗</a><a href={clinic.maps} target="_blank" rel="noopener noreferrer">Find us on Google Maps ↗</a><a href="/">Return to the clinic website</a></div></div><div class="container footer-bottom"><span>© 2026 Shakuntala Dental Clinic. All rights reserved.</span><span class="footer-credit">Designed &amp; developed by <a href="https://anandbuild.dev/" target="_blank" rel="noopener noreferrer">ANAND</a> ↗</span></div></footer>
<div class="mobile-booking" aria-label="Contact and appointment shortcuts"><a href="tel:+916201049711"><Icon name="phone" size={18}/>Call</a><a href={clinic.whatsapp} target="_blank" rel="noopener noreferrer"><Icon name="whatsapp" size={18}/>WhatsApp</a><a href="/#appointment"><Icon name="calendar" size={18}/>Request visit</a></div>
</body></html>
