---
import BlogLayout from '../../layouts/BlogLayout.astro';
import Icon from '../../components/Icon.astro';
import {clinic} from '../../data.js';
import {treatments} from '../../content/treatments.js';
import posts from '../../content/blogs.json';
export function getStaticPaths(){return treatments.map(treatment=>({params:{slug:treatment.slug},props:{treatment}}));}
const {treatment:t}=Astro.props;
const guide=posts.find(p=>p.slug===t.guide);
const image=`/images/blog/${guide.image}.webp`;
const title=`${t.title} in Munger`;
const description=`${t.short} Discuss ${t.title.toLowerCase()} with Dr. Rohan Bharti, BDS, at Shakuntala Dental Clinic in Mogal Bazar, Munger.`;
const whatsapp=`https://wa.me/916201049711?text=${encodeURIComponent(`Hello Shakuntala Dental Clinic, I would like to request a consultation about ${t.title.toLowerCase()} with Dr. Rohan Bharti. Please confirm availability.`)}`;
const schema={'@context':'https://schema.org','@type':'WebPage',name:title,description,url:new URL(Astro.url.pathname,Astro.site).href,inLanguage:['en-IN','hi-IN'],about:{'@type':'Thing',name:t.title}};
---
<BlogLayout title={title} description={description} image={image} schema={schema}>
<section class="container treatment-page-hero">
 <nav class="breadcrumbs" aria-label="Breadcrumb"><a href="/">Clinic</a><span>/</span><a href="/#services">Treatments</a><span>/</span><span>{t.title}</span></nav>
 <div class="treatment-page-grid"><div><p class="eyebrow">SHAKUNTALA DENTAL CLINIC · MUNGER</p><h1>{title}</h1><p class="treatment-hindi" lang="hi">{t.hindi} · मुंगेर</p><p>{t.short}</p><p lang="hi">{t.shortHindi}</p><p class="treatment-doctor"><strong>Dr. Rohan Bharti, BDS</strong><br/>Dental Surgeon · Mogal Bazar</p><a class="button" href={whatsapp} target="_blank" rel="noopener noreferrer"><Icon name="whatsapp" size={21}/>Request a consultation</a><p lang="hi">परामर्श के लिए व्हाट्सऐप पर समय पूछें।</p></div><figure><img src={image} alt={guide.imageAlt} width="1200" height="800" fetchpriority="high"/><figcaption>Educational illustration</figcaption></figure></div>
</section>
<div class="container article-layout">
 <article class="article-body">
  <section><h2>Understanding {t.title.toLowerCase()}</h2><p>{t.detail}</p><p lang="hi">{t.detailHindi}</p></section>
  <section><h2>{t.heading}</h2><p lang="hi">{t.headingHindi}</p><p>{t.text}</p><p lang="hi">{t.textHindi}</p></section>
  <section class="article-questions"><h2>{t.question}</h2><p>{t.answer}</p><h3 lang="hi">{t.questionHindi}</h3><p lang="hi">{t.answerHindi}</p></section>
  <section><h2>Costs and your treatment plan</h2><p>Ask for an estimate after the examination, including the proposed treatment, appointments and follow-up. The clinic will confirm availability and your appointment request on WhatsApp or by phone.</p><p lang="hi">जाँच के बाद इलाज, मुलाकातों और बाद की देखभाल का खर्च पूछें। क्लिनिक व्हाट्सऐप या फोन पर उपलब्धता और समय की पुष्टि करेगा।</p></section>
  <section><h2>Read more before your visit</h2><a class="text-link" href={`/blog/${guide.slug}/`}>{guide.title} ↗</a><p class="article-source">Patient information: <a href={guide.source.url} target="_blank" rel="noopener noreferrer">{guide.source.name || 'Read the supporting dental guide'} ↗</a></p></section>
 </article>
 <aside class="article-sidebar"><p class="eyebrow">PLAN YOUR VISIT · <span lang="hi">मुलाकात</span></p><h2>Visit Dr. Rohan Bharti</h2><p>{clinic.address}<br/>Beside Utkarsh Small Finance Bank and Jan Aushadhi Kendra.</p><p>Monday–Sunday<br/>10:30 AM–7:00 PM</p><a class="button" href={whatsapp} target="_blank" rel="noopener noreferrer"><Icon name="whatsapp" size={19}/>Enquire on WhatsApp</a><a class="text-link" href="tel:+916201049711">Call {clinic.phone}</a><a class="text-link" href={clinic.maps} target="_blank" rel="noopener noreferrer">Get directions ↗</a><small>Your visit is confirmed by the clinic.<br/><span lang="hi">समय की पुष्टि क्लिनिक करेगा।</span></small></aside>
</div>
<section class="container blog-category"><h2>Explore other treatments · <span lang="hi">अन्य इलाज</span></h2><nav class="treatment-page-links" aria-label="Other treatments">{treatments.filter(other=>other.slug!==t.slug).map(other=><a href={`/treatments/${other.slug}/`}>{other.title}<span lang="hi">{other.hindi}</span><span aria-hidden="true">↗</span></a>)}</nav></section>
</BlogLayout>
<style>
.treatment-page-hero{padding-top:30px}.treatment-page-grid{display:grid;grid-template-columns:1fr 1fr;align-items:center;gap:48px}.treatment-page-grid h1{font-size:clamp(36px,4.2vw,60px);line-height:1.1;letter-spacing:-.04em}.treatment-page-grid p{line-height:1.7;margin-top:14px}.treatment-page-grid .eyebrow{font-size:12px;margin:0 0 20px}.treatment-hindi{font-size:23px;color:#526c89}.treatment-doctor{margin:25px 0!important}.treatment-page-grid img{width:100%;height:auto;border-radius:16px}.treatment-page-grid figcaption{font-size:12px;color:var(--muted);margin-top:8px}.treatment-page-links{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}.treatment-page-links a{padding:20px;border:1px solid var(--line);border-radius:10px;font-weight:600}.treatment-page-links span[lang]{display:block;font-size:14px;font-weight:400;margin-top:8px}.article-body p+p{margin-top:16px}.article-questions h3{font-size:21px;margin-top:25px}.treatment-page-links a:hover{background:#edf5fa}@media(max-width:760px){.treatment-page-grid{grid-template-columns:1fr;gap:28px}.treatment-page-links{grid-template-columns:1fr 1fr}.treatment-page-grid .button{font-size:15px}}@media(max-width:440px){.treatment-page-links{grid-template-columns:1fr}}
</style>
