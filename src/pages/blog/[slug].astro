---
import BlogLayout from '../../layouts/BlogLayout.astro';
import posts from '../../content/blogs.json';
export function getStaticPaths(){return posts.map(post=>({params:{slug:post.slug},props:{post}}));}
const {post}=Astro.props;
const canonical=new URL(`/blog/${post.slug}/`,Astro.site);
const image=`/images/blog/${post.image}.webp`;
const related=posts.filter(p=>p.slug!==post.slug).sort((a,b)=>Number(b.category===post.category)-Number(a.category===post.category)).slice(0,3);
const schema={'@context':'https://schema.org','@type':'Article',headline:post.title,description:post.description,image:new URL(image,Astro.site).href,mainEntityOfPage:canonical.href,inLanguage:'en-IN',creativeWorkStatus:post.reviewed?'Published':'Draft',citation:post.source.url};
const words=[post.intro,...post.sections.map(s=>s.text),...post.questions].join(' ').split(/\s+/).length;
const imageAlt={prevention:'Conceptual tooth, toothbrush and daily-care illustration',comfort:'Conceptual tooth with a soft blue cushion and attention symbol',restoration:'Conceptual ceramic teeth and separate crown illustration',smile:'Conceptual dental arch and implant illustration',family:'Large and small tooth sculptures with a child-sized toothbrush',visit:'Illustrated consultation desk with a blank appointment card'};
---
<BlogLayout title={post.title} description={post.description} image={image} schema={schema} draft={!post.reviewed}>
<article><header class="article-header container"><nav class="breadcrumbs" aria-label="Breadcrumb"><a href="/">Clinic</a><span>/</span><a href="/blog/">Dental guides</a><span>/</span><span>{post.category}</span></nav><p class="eyebrow">{post.category} · {Math.max(2,Math.ceil(words/200))} MIN READ</p><h1>{post.title}</h1><p class="article-hindi" lang="hi">{post.hindi}</p><p class="article-summary">{post.description}</p><p class="article-meta">Prepared for Shakuntala Dental Clinic · Munger</p>{!post.reviewed&&<p class="review-label">Editorial draft · Clinical review pending. General patient education.</p>}<figure><img src={image} alt={imageAlt[post.image]} width="1200" height="800" fetchpriority="high"/><figcaption>AI-generated editorial illustration · not a diagnostic model or treatment result.</figcaption></figure></header>
<div class="container article-layout"><div class="article-body"><p class="article-lead">{post.intro}</p><nav class="article-toc" aria-label="On this page"><strong>In this guide</strong>{post.sections.map((s,i)=><a href={`#section-${i+1}`}>{s.heading}</a>)}</nav>{post.sections.map((s,i)=><section id={`section-${i+1}`}><h2>{s.heading}</h2><p>{s.text}</p></section>)}<section class="article-questions"><h2>Questions to take to your appointment</h2><ul>{post.questions.map(q=><li>{q}</li>)}</ul></section><section class="article-source"><h2>Further reading</h2><p>This article uses general patient information from <a href={post.source.url} target="_blank" rel="noopener noreferrer">{post.source.title} ↗</a>. International sources explain general dental care; their local services, fees and emergency numbers do not apply in India.</p><p>General education only. An examination is needed for diagnosis and treatment advice. Confirm proposed services and availability with the clinic.</p></section></div><aside class="article-sidebar"><p class="eyebrow">A CONVERSATION IS A GOOD START</p><h2>Talk to your<br/>dentist in Munger.</h2><p><strong>Dr. Rohan Bharti</strong><br/>BDS · Dental Surgeon</p><p>Shakuntala Dental Clinic<br/>Mogal Bazar, Munger</p><a class="button" href="/#appointment">Request a consultation ↗</a><a class="text-link" href="tel:+916201049711">Call +91 62010 49711</a><small>Every day · 10:30 AM–7:00 PM<br/>Requests require clinic confirmation.</small></aside></div></article>
<section class="container blog-category"><div class="blog-related-heading"><h2>Keep exploring</h2><a class="text-link" href="/blog/">All 20 guides ↗</a></div><div class="blog-cards">{related.map(p=><a class="blog-card" href={`/blog/${p.slug}/`}><img src={`/images/blog/${p.image}.webp`} alt="" width="1200" height="800" loading="lazy"/><div><small>{p.category}</small><h3>{p.title}</h3><span>Read the guide ↗</span></div></a>)}</div></section>
</BlogLayout>
