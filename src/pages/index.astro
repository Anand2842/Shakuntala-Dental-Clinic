---
import Icon from '../components/Icon.astro';
import { clinic, steps } from '../data.js';
import '../styles/global.css';
import '../styles/blog.css';
import posts from '../content/blogs.json';
import { treatments } from '../content/treatments.js';
const orderedServices = [0,6,5,9,3,1,2,4,7,8].map(i=>treatments[i]);
const serviceArt = [0,1,2,3,4,4,3,1,0,0];
const canonical = new URL(Astro.url.pathname, Astro.site);
const schema = {
  '@context': 'https://schema.org', '@type': 'Dentist', '@id': `${Astro.site}#clinic`,
  name: clinic.name, url: Astro.site?.href, telephone: '+916201049711',
  foundingDate: '2026-08',
  image: new URL('/images/doctor-at-clinic.webp', Astro.site).href,
  employee: { '@type': 'Person', '@id': `${Astro.site}#doctor`, name: clinic.doctor, jobTitle: 'Dental Surgeon', hasCredential: { '@type': 'EducationalOccupationalCredential', name: 'Bachelor of Dental Surgery (BDS)', credentialCategory: 'Degree' } },
  areaServed: { '@type': 'City', name: 'Munger' },
  address: { '@type': 'PostalAddress', streetAddress: 'Ground Floor, D.N. Road, Mogal Bazar, Madhopur, Purabsarai', addressLocality: 'Munger', addressRegion: 'Bihar', postalCode: '811202', addressCountry: 'IN' },
  openingHoursSpecification: [{ '@type': 'OpeningHoursSpecification', dayOfWeek: ['Monday','Tuesday','Wednesday','Thursday','Friday','Saturday','Sunday'], opens: '10:30', closes: '19:00' }]
};
const faqs = [
  { q: 'Where can I find the clinic?', hi: 'क्लिनिक कहाँ है?', a: `${clinic.address}. We are beside Utkarsh Small Finance Bank and Jan Aushadhi Kendra. Call us if you need help finding the clinic.`, hindi: 'क्लिनिक मोगल बाज़ार, मुंगेर में उत्कर्ष स्मॉल फाइनेंस बैंक और जन औषधि केंद्र के बगल में है।' },
  { q: 'What are your opening hours?', hi: 'क्लिनिक कब खुलता है?', a: 'The clinic is open Monday to Sunday, 10:30 AM to 7:00 PM. Please call to check availability on holidays.', hindi: 'सोमवार से रविवार, सुबह 10:30 से शाम 7:00 बजे। छुट्टियों में आने से पहले फोन करें।' },
  { q: 'How do I request an appointment?', hi: 'अपॉइंटमेंट कैसे लें?', a: 'Enter your name and preferred day to prepare a WhatsApp message, then send it to the clinic. Our team will check availability and confirm your appointment. You can also call +91 62010 49711.', hindi: 'फॉर्म भरकर व्हाट्सऐप पर संदेश भेजें या फोन करें। क्लिनिक की पुष्टि के बाद ही अपॉइंटमेंट तय होगा।' },
  { q: 'What happens during a root canal?', hi: 'रूट कैनाल में क्या होता है?', a: 'The dentist removes infected pulp, cleans the canals, then fills and seals them. A filling or crown may follow. Your dentist explains the plan for your tooth after an examination.', hindi: 'संक्रमित पल्प हटाकर जड़ों की सफाई, फिलिंग और सीलिंग की जाती है। जाँच के बाद डॉक्टर इलाज समझाएँगे।' },
  { q: 'When should I see a dentist for tooth pain?', hi: 'दाँत के दर्द में कब डॉक्टर को दिखाएँ?', a: 'Arrange a dental visit for persistent tooth pain, swelling or pain when biting. Swelling with difficulty breathing or swallowing needs immediate emergency medical care.', hindi: 'लगातार दर्द या सूजन होने पर दंत चिकित्सक से मिलें। साँस लेने या निगलने में तकलीफ के साथ सूजन हो तो तुरंत आपातकालीन सहायता लें।' },
  { q: 'Which dental treatments can I ask about?', hi: 'किन इलाजों की जानकारी ले सकते हैं?', a: 'Explore the treatment information above, then contact the clinic to confirm which services are available and suitable for you. The right treatment depends on a dental examination.', hindi: 'ऊपर इलाज की जानकारी देखें। उपलब्धता और आपके लिए उपयुक्त इलाज की पुष्टि क्लिनिक से करें।' },
  { q: 'Can I request a Sunday appointment?', hi: 'क्या रविवार को अपॉइंटमेंट मिल सकता है?', a: 'Yes. The clinic’s stated hours include Sunday, 10:30 AM to 7:00 PM. Send an appointment request and wait for confirmation before visiting.', hindi: 'हाँ, रविवार को भी सुबह 10:30 से शाम 7:00 बजे तक समय है। आने से पहले अपॉइंटमेंट की पुष्टि करें।' },
  { q: 'Can I book a visit for my child?', hi: 'क्या बच्चों के लिए समय ले सकते हैं?', a: 'Please contact the clinic with your child’s age and ask about a suitable consultation. The team can confirm the care available before you visit.', hindi: 'बच्चे की उम्र बताकर क्लिनिक से सलाह लें और उपलब्ध देखभाल की पुष्टि करें।' }
];
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="theme-color" content="#123c7a" />
  <title>Dentist in Munger | Shakuntala Dental Clinic – Dr. Rohan Bharti</title>
  <meta name="description" content="Visit Shakuntala Dental Clinic in Mogal Bazar, Munger, for dental consultations and treatment with Dr. Rohan Bharti, BDS. Call +91 62010 49711." />
  <link rel="canonical" href={canonical} />
  <meta property="og:type" content="website" /><meta property="og:title" content="Shakuntala Dental Clinic · Care for your smile, in Munger" />
  <meta property="og:description" content="Dental consultations with Dr. Rohan Bharti, BDS. Open all seven days in Mogal Bazar, Munger." />
  <meta property="og:url" content={canonical} /><meta property="og:image" content={new URL('/images/social.png', Astro.site)} />
  <meta name="twitter:card" content="summary_large_image" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="preconnect" href="https://fonts.googleapis.com" /><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;450;500;550;600;650;700&display=swap" rel="stylesheet" />
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
</head>
<body>
  <a class="skip-link" href="#main">Skip to content</a>
  <header class="header"><div class="container nav-inner">
<a class="brand" href="#" aria-label="Shakuntala Dental Clinic home"><img src="/images/glass-tooth.webp" width="38" height="42" alt=""/><span>Shakuntala<small>Dental Clinic</small></span></a>
<nav id="navigation" aria-label="Main navigation"><a href="#about">About us</a><a href="#services">Services</a><a href="#doctor">Our dentist</a><a href="#appointment">Appointment</a><a href="#treatments">Treatments</a><a href="/blog/">Blog</a></nav>
<a class="nav-contact" href="tel:+916201049711" aria-label="Call the clinic on +91 62010 49711"><Icon name="phone" size={16}/> <span>+91 62010 49711</span></a><a class="nav-whatsapp" href={clinic.whatsapp} target="_blank" rel="noopener noreferrer" aria-label="Chat with the clinic on WhatsApp"><Icon name="whatsapp" size={22}/></a><a class="button nav-book" href="#appointment">Request appointment <Icon name="arrowUp" size={17}/></a><button class="menu-toggle icon-button" aria-label="Open navigation" aria-expanded="false" aria-controls="navigation"><Icon name="menu"/></button>
</div></header>
  <main id="main">
    <section class="hero" aria-labelledby="hero-heading"><div class="container hero-scene">
<div class="hero-left"><p class="eyebrow">SHAKUNTALA DENTAL CLINIC · MUNGER</p><h1 id="hero-heading">Your Dentist<br/>in Munger.<br/><span>Care That Feels<br/>Personal.</span></h1><div class="hero-doctor"><strong>Dr. Rohan Bharti</strong><span>BDS · Dental Surgeon</span></div><p class="hero-description">Dental consultations and treatment,<br/>right here in Mogal Bazar.</p><a class="button" href="#appointment"><span class="button-icon"><Icon name="whatsapp" size={20}/></span> Request an appointment</a><a class="hero-mobile-map text-link" href={clinic.maps} target="_blank" rel="noopener noreferrer"><Icon name="pin" size={18}/> Mogal Bazar · Open Google Maps <Icon name="arrowUp" size={16}/></a></div>
<div id="tooth-stage" class="tooth-stage" role="img" aria-label="Illustrative blue glass tooth. Move your pointer or use arrow keys to tilt." tabindex="0"><img class="tooth-art" src="/images/glass-tooth.webp" width="1100" height="1100" alt="Translucent blue glass molar sculpture" fetchpriority="high"/></div>
<aside class="hero-right" aria-label="Visit Shakuntala Dental Clinic"><p class="eyebrow">YOUR VISIT, MADE SIMPLE</p><h2>A little care.<br/>Close to home.</h2><div class="hero-visit"><Icon name="pin" size={22}/><div><strong>Mogal Bazar, Munger</strong><p>Ground Floor, D.N. Road<br/>Beside Utkarsh Small Finance Bank<br/>&amp; Jan Aushadhi Kendra</p></div></div><div class="hero-visit"><Icon name="clock" size={20}/><div><strong>Open all seven days</strong><p>10:30 AM – 7:00 PM</p></div></div><a class="hero-phone" href="tel:+916201049711"><Icon name="phone" size={20}/> +91 62010 49711</a><a class="text-link hero-directions" href={clinic.maps} target="_blank" rel="noopener noreferrer">Find us on Google Maps <Icon name="arrowUp" size={18}/></a></aside>
<div class="hero-controls"><span id="model-caption">Move to explore</span><button id="motion-toggle" class="motion-button" aria-label="Pause tooth animation" aria-pressed="false"><Icon name="pause" size={13}/></button></div>
</div></section>
<div class="visit-strip"><div class="container"><span><Icon name="tooth" size={20}/><strong>Dr. Rohan Bharti, BDS</strong></span><span><Icon name="clock" size={20}/> Monday–Sunday · 10:30 AM–7:00 PM</span><a href={clinic.maps} target="_blank" rel="noopener noreferrer"><Icon name="pin" size={20}/> Mogal Bazar, Munger · 811202 <Icon name="arrowUp" size={15}/></a></div></div>
<section id="about" class="intro-panel container"><div class="intro-copy"><p class="eyebrow">ABOUT US</p><h2>A healthier smile.<br/>A little more confidence.<br/>The Shakuntala difference.</h2><p>Good dental care starts with understanding you. At Shakuntala Dental Clinic, meet Dr. Rohan Bharti, discuss your concerns and explore the next steps for your smile.</p><a href="#doctor" class="text-link">Meet your dentist <Icon name="arrowUp" size={17}/></a></div><img src="/images/glass-arches.webp" alt="Illustrative translucent blue dental arches" width="900" height="900" loading="lazy"/><div class="intro-facts"><div><strong>BDS</strong><span>Dr. Rohan Bharti · Dental Surgeon</span></div><div><strong>7 days</strong><span>Monday to Sunday</span></div><div><strong>10:30–7:00</strong><span>AM to PM · Clinic hours</span></div><div><strong>Aug 2026</strong><span>Clinic established · Mogal Bazar, Munger</span></div></div></section>
    <section id="services" class="section services-section"><div class="container">
      <div class="section-heading centered"><p class="eyebrow">SERVICES · <span lang="hi">सेवाएँ</span></p><h2>Dental treatments in Munger<span class="section-hindi" lang="hi">मुंगेर में दाँतों का इलाज</span></h2><p>Explore dental treatments and find the right place to start.<br/>Your care begins with a conversation.</p></div>
      <div class="services-grid">
        {orderedServices.map((service, i) => <a class:list={['service-card','treatment-link', { 'extra-service': i >= 5 }]} href={`/treatments/${service.slug}/`}>
          <img src={`/images/service-${serviceArt[i]}.webp`} alt="" width="300" height="300" loading="lazy"/>
          <h3>{service.title}</h3><span class="hindi" lang="hi">{service.hindi}</span><p>{service.short}</p><span class="service-learn">Learn about treatment ↗<span lang="hi">इलाज की जानकारी</span></span>
        </a>)}
      </div>
      <div class="services-bottom"><a class="button" href="#appointment"><span class="button-icon"><Icon name="calendar" size={17}/></span>Schedule a visit · <span lang="hi">मिलने का समय लें</span></a><button id="all-services" class="button button-outline" aria-expanded="false">View all 10 treatments · सभी 10 इलाज देखें <Icon name="plus" size={17}/></button><p>Not sure where to start? <span lang="hi">कहाँ से शुरू करें?</span> <a href="#appointment">Request a consultation · <span lang="hi">परामर्श लें</span> <span>↗</span></a></p></div>
    </div></section>
    <section id="planner" class="section quick-appointment" aria-labelledby="appointment-heading"><div id="appointment" class="container quick-booking-grid">
<div class="quick-booking-copy"><p class="eyebrow">A VISIT STARTS WITH A MESSAGE</p><h2 id="appointment-heading">Request your<br/>appointment.</h2><p>Your name. Your preferred day.<br/>We’ll take it from there on WhatsApp.</p><div class="quick-doctor"><strong>Dr. Rohan Bharti, BDS</strong><span>Shakuntala Dental Clinic · Mogal Bazar, Munger</span><span>Monday–Sunday · 10:30 AM–7:00 PM</span></div><a class="text-link" href="tel:+916201049711"><Icon name="phone" size={20}/> Prefer to call? +91 62010 49711</a></div>
<form id="booking-form" class="quick-booking-form"><div class="field"><label for="patient-name">Your name <small lang="hi">आपका नाम</small></label><input id="patient-name" name="name" autocomplete="name" placeholder="Enter your name" required maxlength="80"/></div>
<fieldset class="preferred-day"><legend>Preferred day <small lang="hi">किस दिन आना चाहेंगे?</small></legend><div class="day-options"><label><input type="radio" name="day" id="day-today" value="today" required/><span>Today<small lang="hi">आज</small></span></label><label><input type="radio" name="day" id="day-tomorrow" value="tomorrow"/><span>Tomorrow<small lang="hi">कल</small></span></label><label><input type="radio" name="day" id="day-custom" value="custom" aria-controls="custom-date-field"/><span>Choose a date<small lang="hi">तारीख चुनें</small></span></label></div></fieldset>
<div id="custom-date-field" class="field" hidden><label for="date">Choose your preferred date <small lang="hi">अपनी तारीख चुनें</small></label><input type="date" id="date" name="date" disabled/></div><p id="day-help" class="quick-day-help" aria-live="polite"></p><p id="booking-error" role="alert"></p><button type="submit" class="button quick-booking-submit"><Icon name="whatsapp" size={22}/> Request on WhatsApp <Icon name="arrowUp" size={18}/></button><p class="quick-confirmation">Send your message. The clinic will confirm availability.<br/><span lang="hi">संदेश भेजें। क्लिनिक उपलब्धता की पुष्टि करेगा।</span></p><noscript><p><a href={clinic.whatsapp}>Request directly on WhatsApp</a> or call <a href="tel:+916201049711">+91 62010 49711</a>.</p></noscript></form>
</div></section>
    <section id="treatments" class="treatment-section" aria-labelledby="treatment-heading"><div class="container treatment-layout">
      <div class="treatment-intro"><p class="eyebrow">A LITTLE KNOWLEDGE. A LITTLE LESS WORRY.</p><h2 id="treatment-heading">Root canal treatment.<br/>Understand every step.</h2><p>A look inside the tooth. A step-by-step guide to how root canal treatment is commonly performed.</p><a class="skip-animation" href="#doctor">Skip the walkthrough <span>↓</span></a></div>
      <div class="treatment-experience" data-step="0">
        <div class="treatment-visual"><span class="diagram-label">INSIDE YOUR TOOTH</span><div class="treatment-art-frames">{steps.map((step, i) => <img class:list={["treatment-art",{active:i===0}]} src={i===0 ? "/images/treatment/step-1.webp" : undefined} data-src={`/images/treatment/step-${i+1}.webp`} data-frame={i} aria-hidden={i!==0} alt={`General educational cutaway: ${step.label.toLowerCase()}`} width="400" height="800" loading="lazy" decoding="async" />)}</div><div class="diagram-footer"><span>GENERAL EDUCATIONAL ILLUSTRATION</span><button id="replay" aria-label="Play root canal walkthrough"><Icon name="play" size={16}/><span>Play walkthrough</span></button></div></div>
        <div class="treatment-story"><div class="step-count"><span id="step-number">01</span> <span>/ 05</span></div><div class="step-buttons" role="group" aria-label="Root canal treatment steps">{steps.map((step, i) => <button class:list={['step-button',{ active:i===0 }]} data-step={i} aria-pressed={i===0}><span>{String(i+1).padStart(2,'0')}</span><span>{step.label}</span></button>)}</div><div id="step-content" aria-live="polite"><h3>{steps[0].title}</h3><p>{steps[0].text}</p></div><div class="step-navigation"><button id="step-prev" class="icon-button" aria-label="Previous treatment step" disabled><span>←</span></button><span>Tap a step to explore</span><button id="step-next" class="icon-button" aria-label="Next treatment step"><Icon name="arrow" size={20}/></button></div></div>
      </div>
      <details class="treatment-transcript"><summary>Read the full treatment guide <Icon name="plus" size={16}/></summary><ol>{steps.map(step => <li><h3>{step.title}</h3><p>{step.text}</p></li>)}</ol></details>
      <div class="educational-note"><Icon name="shield" size={18}/><p>This general guide is for education, not diagnosis. Treatment and outcomes vary. Your dentist will explain the care appropriate for you. <a href="https://www.aae.org/patients/root-canal-treatment/what-is-a-root-canal/root-canal-explained/" target="_blank" rel="noopener noreferrer">Patient information: AAE ↗</a></p></div>
    </div></section>
    <section id="doctor" class="section about-section"><div class="container about-grid">
      <figure class="doctor-photo"><img src="/images/dr-rohan-bharti-portrait.webp" alt="Portrait of Dr. Rohan Bharti with a blue studio background" width="900" height="1125" loading="lazy"/><figcaption><strong>Dr. Rohan Bharti</strong><span>BDS · Dental Surgeon</span></figcaption></figure>
      <div class="about-copy"><p class="eyebrow">MEET YOUR DENTIST</p><h2>Meet Dr. Rohan Bharti</h2><p class="doctor-designation">BDS · Dental Surgeon in Munger</p><p>At Shakuntala Dental Clinic, Dr. Rohan Bharti provides dental consultations and treatment for patients in Munger.</p><p>Bring your questions, tell us what’s troubling you, and discuss the next steps for your dental care. A consultation is the place to understand your options.</p><dl class="doctor-credentials"><div><dt>Qualification</dt><dd>Bachelor of Dental Surgery (BDS)</dd></div><div><dt>Additional training</dt><dd>Microendodontics &amp; cosmetic dentistry</dd></div><div><dt>Clinic established</dt><dd>August 2026</dd></div><div><dt>Practising at</dt><dd>Shakuntala Dental Clinic<br/>Mogal Bazar, Munger</dd></div></dl><a class="google-rating" href="https://www.google.com/maps/place/SHAKUNTALA+DENTAL+CLINIC+(+DR.ROHAN+BHARTI)/data=!4m2!3m1!1s0x0:0x9c55a0ab41964c07" target="_blank" rel="noopener noreferrer"><span aria-hidden="true">★</span> 5.0 on Google Reviews <Icon name="arrowUp" size={16}/></a><a class="button" href="#appointment">Request a visit with Dr. Rohan Bharti <Icon name="arrowUp" size={18}/></a></div>
    </div></section>
    <section id="clinic" class="section gallery-section"><div class="container"><div class="section-heading"><div><p class="eyebrow">A FAMILIAR PLACE FOR YOUR CARE</p><h2>Your dentist.<br/><em>A look inside the clinic.</em></h2></div><div class="heading-aside"><p>Shakuntala Dental Clinic<br/>Mogal Bazar, Munger, Bihar.</p><a class="text-link" href="#contact">Plan your visit <Icon name="arrowUp" size={17}/></a></div></div><div class="gallery-grid">
      <figure class="gallery-photo clinic-desk"><img src="/images/doctor-at-clinic.webp" alt="Dr. Rohan Bharti seated at his desk at Shakuntala Dental Clinic" width="718" height="1599" loading="lazy"/><figcaption><span>At Shakuntala Dental Clinic</span><small>Dr. Rohan Bharti at his consultation desk</small></figcaption></figure>
      <figure class="gallery-photo clinic-work"><img src="/images/doctor-at-work-enhanced.webp" alt="Dr. Rohan Bharti wearing dental loupes during clinical work" width="1200" height="900" loading="lazy"/><figcaption><span>A closer look at care</span><small>Dr. Rohan Bharti working with dental loupes</small></figcaption></figure>
      <figure class="gallery-photo clinic-instrument"><div class="instrument-frame"><img src="/images/endodontic-instrument.webp" alt="Close-up of a dental instrument marked Dr. Rohan Bharti" width="738" height="1600" loading="lazy"/></div><figcaption><span>Endodontic instrument detail</span><small>A photograph supplied by the clinic</small></figcaption></figure>
    </div></div></section>
    <section id="journal" class="section home-journal"><div class="container"><div class="blog-related-heading"><div><h2>Good questions.<br/>A clearer next step.</h2><p>Explore dental care guides, treatment questions and practical advice for your next visit in Munger.</p></div><a class="button blog-link-all" href="/blog/">Explore all {posts.length} guides <Icon name="arrowUp" size={18}/></a></div><div class="blog-cards">{[posts[0],posts[3],posts[13]].map(post=><a class="blog-card" href={`/blog/${post.slug}/`}><img src={`/images/blog/${post.image}.webp`} alt="" width="1200" height="800" loading="lazy"/><div><small>{post.category}</small><h3>{post.title}</h3><p>{post.description}</p><span>Read the guide ↗</span></div></a>)}</div></div></section>
    <section id="faqs" class="section faq-section"><div class="container faq-grid"><div><p class="eyebrow">GOOD QUESTIONS. CLEAR ANSWERS.</p><h2>A little clarity<br/><em>before your visit.</em></h2><p>Common questions about dental care<br/>and visiting our clinic.</p><a class="text-link" href={clinic.whatsapp} target="_blank" rel="noopener noreferrer"><Icon name="whatsapp" size={19}/> Ask us on WhatsApp <Icon name="arrowUp" size={16}/></a></div><div class="faq-list">{faqs.map(faq => <details name="faq"><summary><span>{faq.q}<small lang="hi">{faq.hi}</small></span><Icon name="plus" size={19}/></summary><div class="faq-answer"><p>{faq.a}</p><p lang="hi">{faq.hindi}</p></div></details>)}</div></div></section>
